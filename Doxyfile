PROJECT_NAME           = "upload-sarif-to-defectdojo"
PROJECT_BRIEF          = "Reference documentation for the DefectDojo SARIF uploader"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

INPUT                  = README.md \
                         src/upload_sarif_to_defectdojo.bash \
                         doc/adr \
                         doc/standards/bash/documentation-standard.md
RECURSIVE              = YES
FILE_PATTERNS          = *.bash \
                         *.md

EXCLUDE                = vendor \
                         dist \
                         tests \
                         doc/reference \
                         doc/adr/templates
EXCLUDE_PATTERNS       = */vendor/* \
                         */dist/* \
                         */tests/* \
                         */doc/reference/* \
                         */doc/adr/templates/*

EXTENSION_MAPPING      = bash=C++
FILTER_PATTERNS        = *.bash="awk -f vendor/doxygen-bash.awk"

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
